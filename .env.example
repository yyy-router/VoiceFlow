DASHSCOPE_API_KEY=your_api_key_here
ASR_MODEL=qwen-asr-realtime
LLM_MODEL=qwen-plus

# Production access control: set both credentials, or explicitly allow anonymous access
# behind an authenticated gateway / for a deliberately public demo.
# SPEECH_AUTH_USER=voiceflow
# SPEECH_AUTH_PASSWORD=replace_with_a_strong_password
# SPEECH_ALLOW_ANONYMOUS=true
# SPEECH_MAX_SESSIONS=16
# SPEECH_MAX_SESSIONS_PER_IP=2
# SPEECH_MAX_STARTS_PER_MINUTE=120
# SPEECH_MAX_STARTS_PER_IP_PER_MINUTE=12
# SPEECH_ALLOW_MISSING_ORIGIN=false
# Only these proxy peer IPs may supply X-Real-IP; all other forwarded headers are ignored.
# SPEECH_TRUSTED_PROXY_IPS=127.0.0.1,::1
